# descriptor.proto.
"uni-name="
"uni-version="
"bufbuild/es"
"v2.17.0"
"target="
"ts"
"js"
"dts"
"+"
","
"="
":"
"true"
"false"
"import_extension="
".js"
"none"
"js_import_style=legacy_commonjs"
"js_import_style=module"
"keep_empty_files=true"
"ts_nocheck=true"
"elide_plugin_version=true"
"bootstrap_wkt=true"
"rewrite_imports="
"map_imports="
"**/"
"*"
"json_types=true"
"valid_types=legacy_required"
"valid_types=protovalidate_required"
"erasable_syntax=true"
